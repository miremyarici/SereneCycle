# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur.
# `.env` git'e girmez (.gitignore'da).

# --- PostgreSQL ---
POSTGRES_DB=serenecycle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=degistir-beni

# --- JWT ---
# En az 32 karakter. Üretmek için:
#   openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=serene-cycle-api
JWT_AUDIENCE=serene-cycle-app

# --- Gmail API (OAuth 2.0) ---
# false ise e-postalar gönderilmez, loga yazılır. Kurulum: backend/README.md
GMAIL_USE_REAL_SENDER=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# --- Ortam ---
ASPNETCORE_ENVIRONMENT=Development
